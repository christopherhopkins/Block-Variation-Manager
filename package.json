{
	"name": "block-variation-manager",
	"version": "0.1.0",
	"description": "Save any block's attributes as a named variation; propagate edits site-wide while preserving per-instance overrides.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "webpack --config webpack.config.cjs --mode production",
		"start": "webpack --config webpack.config.cjs --mode development --watch",
		"test:unit": "wp-scripts test-unit-js --config jest.config.cjs",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/Block-Variation-Manager vendor/bin/phpunit",
		"test:php:ms": "wp-env run tests-cli --env-cwd=wp-content/plugins/Block-Variation-Manager bash -c \"WP_MULTISITE=1 vendor/bin/phpunit\"",
		"test:e2e": "playwright test",
		"playground": "npx -y @wp-playground/cli@latest server --blueprint=./blueprint.json",
		"playground:local": "node scripts/playground-local.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/env": "^10.39.0",
		"@wordpress/scripts": "^30.0.0"
	},
	"dependencies": {
		"driver.js": "1.3.6"
	}
}
